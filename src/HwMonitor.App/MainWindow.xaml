<Window x:Class="HwMon.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HwMon — sensores do sistema"
        Height="780" Width="1120"
        MinHeight="480" MinWidth="760"
        Background="{StaticResource WindowBackground}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="HwMon" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="monitor de sensores" Foreground="{StaticResource TextSecondary}"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <TextBox Grid.Column="1" x:Name="FilterBox" Margin="24,0" VerticalAlignment="Center"
                     Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Filtrar por sensor ou hardware" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="IntervalBox" Width="92" Margin="0,0,8,0"
                          SelectionChanged="OnIntervalChanged" ToolTip="Intervalo de atualização">
                    <ComboBoxItem Content="0,5 s" Tag="500" />
                    <ComboBoxItem Content="1 s" Tag="1000" IsSelected="True" />
                    <ComboBoxItem Content="2 s" Tag="2000" />
                    <ComboBoxItem Content="5 s" Tag="5000" />
                </ComboBox>
                <Button Content="{Binding PauseLabel}" Click="OnTogglePause" />
                <Button Content="{Binding LogLabel}" Click="OnToggleLog" />
                <Button Content="Resetar" Click="OnReset" />
            </StackPanel>
        </Grid>

        <!-- Barra de alertas -->
        <Border Grid.Row="1" Background="#2A1B1B" BorderBrush="{StaticResource Alert}" BorderThickness="1"
                CornerRadius="4" Padding="10,6" Margin="0,0,0,10"
                Visibility="{Binding HasAlert, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding AlertText}" Foreground="{StaticResource Alert}" TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- Tabela de sensores -->
        <Border Grid.Row="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="6" ClipToBounds="True">
            <ListView x:Name="SensorList"
                      ItemsSource="{Binding SensorsView}"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{StaticResource TextPrimary}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                      ItemContainerStyle="{StaticResource SensorItemStyle}">

                <ListView.Resources>
                    <Style TargetType="GridViewColumnHeader">
                        <Setter Property="Background" Value="#1B222C" />
                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GridViewColumnHeader">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{StaticResource Border}"
                                            BorderThickness="0,0,0,1"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.Resources>

                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <StackPanel>
                                                <Border Background="#1B222C" BorderBrush="{StaticResource Border}"
                                                        BorderThickness="0,0,0,1" Padding="12,7" Margin="0,8,0,0">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Accent}" />
                                                        <TextBlock HorizontalAlignment="Right" FontSize="11"
                                                                   Foreground="{StaticResource TextSecondary}"
                                                                   Text="{Binding ItemCount, StringFormat={}{0} sensores}" />
                                                    </Grid>
                                                </Border>
                                                <ItemsPresenter />
                                            </StackPanel>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListView.GroupStyle>

                <ListView.View>
                    <GridView>
                        <GridViewColumn x:Name="NameColumn" Header="Sensor" Width="360">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Margin="12,0,8,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Tipo" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding KindLabel}" Margin="12,0,8,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondary}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Valor" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayValue}" Margin="8,0,12,0"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" FontWeight="SemiBold" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Mín" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MinText}" Margin="8,0,12,0"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Foreground="{StaticResource TextSecondary}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Máx" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MaxText}" Margin="8,0,12,0"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Foreground="{StaticResource TextSecondary}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Média" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding AverageText}" Margin="8,0,12,0"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Foreground="{StaticResource TextSecondary}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Rodapé -->
        <Grid Grid.Row="3" Margin="2,10,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextPrimary}" />
                <TextBlock Text="·" Foreground="{StaticResource TextSecondary}" Margin="8,0" />
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondary}"
                           TextTrimming="CharacterEllipsis" MaxWidth="620" />
            </StackPanel>

            <TextBlock Grid.Column="1" Text="MSR/SMBus exigem execução como administrador"
                       Foreground="{StaticResource TextSecondary}" Margin="16,0,0,0" />
        </Grid>
    </Grid>
</Window>
